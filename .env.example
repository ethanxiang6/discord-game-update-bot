# ============================================================================
# REQUIRED: Discord Bot Credentials
# Get these from https://discord.com/developers/applications
# ============================================================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Optional: Set a specific Guild (Server) ID for instant slash command registration during testing
DISCORD_GUILD_ID=

# ============================================================================
# OPTIONAL: Extended Game Catalog APIs (Bot works out-of-the-box without these!)
# By default, the bot uses Steam's keyless APIs + CheapShark + Wikidata + built-in
# console/launcher catalog & official RSS feeds.
# Add RAWG or IGDB keys below to expand search to 500,000+ historical console games.
# ============================================================================
# Get a free key at https://rawg.io/apidocs
RAWG_API_KEY=

# Optional Twitch/IGDB credentials (https://api-docs.igdb.com/#getting-started)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Google AI Studio key. Lets the bot double-check that a ticket message really suggests the matched game.
GEMINI_API_KEY=

# ============================================================================
# Polling & Tracker Configuration
# ============================================================================
# How often to check for new game updates (in minutes, default: 10)
UPDATE_CHECK_INTERVAL_MINUTES=10
